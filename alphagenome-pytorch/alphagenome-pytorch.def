Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

%labels
    Author Adam He
    Description Personal PRO-cap benchmark Apptainer image for Sherlock
    Scope Benchmark-focused PyTorch/AlphaGenome/GenVarLoader environment

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    mkdir -p /tmp /var/tmp /opt/apptainer-build-cache/pip /opt/apptainer-build-cache/xdg
    chmod 1777 /tmp /var/tmp
    export TMPDIR=/tmp
    export TMP=/tmp
    export TEMP=/tmp
    export PIP_CACHE_DIR=/opt/apptainer-build-cache/pip
    export PIP_BREAK_SYSTEM_PACKAGES=1
    export XDG_CACHE_HOME=/opt/apptainer-build-cache/xdg

    apt-get update
    apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        python-is-python3 \
        git \
        curl \
        wget \
        build-essential \
        ca-certificates \
        samtools \
        bcftools \
        tabix \
        bedtools \
        libcurl4-openssl-dev \
        libssl-dev \
        libffi-dev \
        libbz2-dev \
        liblzma-dev \
        libzstd-dev \
        pkg-config \
        zlib1g-dev
    rm -rf /var/lib/apt/lists/*

    PYTORCH_INDEX_URL="${PYTORCH_INDEX_URL:-https://download.pytorch.org/whl/cu128}"
    PYTORCH_SPEC="${PYTORCH_SPEC:-torch==2.10.0+cu128}"
    ALPHAGENOME_PYTORCH_REF="${ALPHAGENOME_PYTORCH_REF:-64fdea871}"

    python -m pip install --ignore-installed --upgrade pip setuptools packaging wheel

    python -m pip install \
        --index-url "${PYTORCH_INDEX_URL}" \
        "${PYTORCH_SPEC}"

    # Keep fragile large scientific packages on wheels in the container.
    python -m pip install --only-binary=:all: \
        numpy \
        scipy \
        pandas \
        polars \
        pyarrow \
        matplotlib \
        tqdm \
        safetensors \
        pyBigWig \
        pybigtools \
        pysam \
        pyfaidx \
        packaging \
        requests

    python -m pip install --only-binary=:all: \
        "numba<0.63" \
        "llvmlite<0.46"

    python -m pip install \
        "git+https://github.com/genomicsxai/alphagenome-pytorch.git@${ALPHAGENOME_PYTORCH_REF}" \
        tangermeme \
        "genvarloader>=0.25.0"
    rm -rf /opt/apptainer-build-cache
%environment
    export PYTHONNOUSERSITE=1
    export PIP_BREAK_SYSTEM_PACKAGES=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export NUMBA_CACHE_DIR=/tmp/numba_cache
    export TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor_cache
    export TRITON_CACHE_DIR=/tmp/triton_cache
    export XDG_CACHE_HOME=/tmp/.cache
    export MPLCONFIGDIR=/tmp/matplotlib
%runscript
    exec "$@"
%test
    python - <<'PY'
import importlib
import torch
for package in (
    "alphagenome_pytorch",
    "tangermeme",
    "genvarloader",
    "pyBigWig",
    "pybigtools",
    "pandas",
    "polars",
):
    module = importlib.import_module(package)
    print(package, getattr(module, "__version__", "ok"))
print("torch", torch.__version__)
print("torch_cuda", torch.version.cuda)
print("cuda_available", torch.cuda.is_available())
if not torch.__version__.startswith("2.10.0+cu128"):
    raise SystemExit(f"Unexpected torch build: {torch.__version__}")
PY