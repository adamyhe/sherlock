Bootstrap: docker
From: pytorch/pytorch:2.13.0-cuda12.6-cudnn9-runtime

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        git wget curl build-essential \
        samtools bedtools tabix \
        libcurl4-openssl-dev libssl-dev libbz2-dev liblzma-dev zlib1g-dev
    rm -rf /var/lib/apt/lists/*

    # This image's Python is the Ubuntu 24.04 system Python, which refuses
    # bare `pip install` under PEP 668 ("externally-managed-environment").
    # That protection exists to keep pip from clobbering apt-managed
    # packages on a real, shared system; it doesn't apply to a
    # single-purpose container image being built for this one application,
    # so --break-system-packages on every install below is safe here.

    # Don't touch setuptools; there's no need to for a --no-deps install
    # below, and some base torch builds pin it against their own build.
    python -m pip install --break-system-packages --upgrade pip wheel

    # Install non-PyTorch Cherimoya dependencies while preserving the
    # base image's own torch/torchvision build (torch 2.13.0, CUDA 12.6).
    python -m pip install --break-system-packages pynvml \
        numpy scipy pandas h5py tqdm seaborn modisco tangermeme \
        bam2bw "lightning>=2.6.1" "scikit-learn>=1.7.2"

    # bpnet-lite declares an unconditional macs3 dependency that nothing in
    # this repo calls; --no-deps skips it (bpnetlite.performance, the only
    # submodule Cherimoya's scripts import, only needs torch and its own
    # .losses module, both already present).
    python -m pip install --break-system-packages --no-deps bpnet-lite

    # Cherimoya v0.3.0: DeepLIFT/SHAP attribution with correct rules,
    # PyTorch Lightning training, held-out test evaluation, kernel autotuning,
    # and seqlet coordinate fix. --no-deps avoids replacing the base image's
    # torch 2.13.0 build with a fresh PyPI resolve.
    python -m pip install --break-system-packages --no-deps "cherimoya @ git+https://github.com/jmschrei/cherimoya.git@v0.3.0"

    # Optional but useful for source/debugging
    python -m pip install --break-system-packages pytest ipython jupyter pandas polars pyBigWig pysam

%environment
    export PYTHONNOUSERSITE=1
    export NUMBA_CACHE_DIR=/tmp/numba_cache/
    export TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor_cache
    export TRITON_CACHE_DIR=/tmp/triton_cache
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec "$@"

%test
    which cherimoya
    cherimoya --help >/dev/null
    python -c "import torch, cherimoya, lightning, bpnetlite.performance, tangermeme; print('cherimoya API ok; torch', torch.__version__)"
